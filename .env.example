# Copiar a .env.local (desarrollo) o cargar como variables de entorno en el hosting.
# Nunca subir valores reales al repositorio.

# Conexión MySQL. En Hostinger, desde la propia app: host 127.0.0.1, puerto 3306.
DATABASE_URL=mysql://usuario:contraseña@127.0.0.1:3306/norde_caja

# Clave para firmar las sesiones (mínimo 32 caracteres al azar).
SESSION_SECRET=

# Sólo para `pnpm crear-admin`.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=
